{
  "name": "mouna",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:local": "pnpm --filter @mouna/tools db"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "turbo": "^2.11.13",
    "typescript": "^6.0.3"
  }
}
